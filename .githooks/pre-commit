#!/bin/sh
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Tests create isolated repositories. Do not leak the calling repository into
# their Git subprocesses through hook-only environment variables.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

echo "Running Lotion package coverage gate..."
npm run test:coverage
